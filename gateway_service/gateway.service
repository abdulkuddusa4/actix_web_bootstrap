[Unit]
Description=API Gateway Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/gateway_service
EnvironmentFile=/opt/gateway_service/.env
ExecStart=/usr/local/bin/gateway_service
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gateway_service

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway_service

# Allow binding to port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
